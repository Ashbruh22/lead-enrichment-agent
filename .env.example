# Required: Google Gemini API key -- create one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: overrides the default model (gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: Tavily key, used as a fallback for LinkedIn lookup if
# the built-in browser search gets rate-limited. https://tavily.com
# TAVILY_API_KEY=
