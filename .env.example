# Required: Google Gemini API key -- create one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional: overrides the default model (gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Recommended: Tavily key. This is what makes the LinkedIn lookup work --
# without it the agent falls back to scraping Brave/DuckDuckGo, which
# rate-limit quickly. Free tier: https://tavily.com
TAVILY_API_KEY=
